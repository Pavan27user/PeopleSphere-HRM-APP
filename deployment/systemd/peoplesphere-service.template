[Unit]
Description=PeopleSphere SERVICE_NAME Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/peoplesphere/SERVICE_NAME
EnvironmentFile=/etc/peoplesphere/SERVICE_NAME.env
ExecStart=/usr/bin/java -jar /opt/peoplesphere/SERVICE_NAME/SERVICE_NAME.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
